# Copy this file to .env and fill in your key. .env is gitignored.
# Free key: https://aistudio.google.com/apikey
# Stay free: create the key in a Google Cloud project WITHOUT billing enabled
# (AI Studio's default project). With no billing account, Google cannot charge you -
# the worst case is a "quota exceeded" error. Free-tier prompts may be used by Google to
# improve its products; we only send public school web pages.
GEMINI_API_KEY=

# Models (Gemini free tier, Sept 2026). Free quotas are per model, so extraction and chat
# use different models. Other free options: gemini-3.7-flash, gemini-3.5-flash, gemini-3.1-flash-lite
EXTRACT_MODEL=gemini-3.8-flash
CHAT_MODEL=gemini-3.5-flash-lite
# Gemini 3 always "thinks" a little; low keeps it short (low | medium | high)
THINKING_LEVEL=low
# Free models tried in order when the main model is overloaded (503) or out of free quota.
# (gemini-3.5-flash-lite is left out on purpose: it is reserved for the Ask chat.)
FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Free-tier limits: check YOUR numbers at https://aistudio.google.com/rate-limit
# and keep these at or below them. Observed Sept 2026: 20 requests/day per model on the free tier.
GEMINI_RPM=5
GEMINI_TPM=100000
# Per model, per day (day = Pacific time, like Google's quota reset). The run stops cleanly
# before exceeding these and resumes where it left off.
DAILY_REQUEST_BUDGET=20
DAILY_TOKEN_BUDGET=1000000
MAX_OUTPUT_TOKENS=8000

# Local embeddings (fastembed, runs on CPU, free)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Crawling
CRAWL_MAX_PAGES=20
CRAWL_DEPTH=2
CRAWL_DELAY_SECONDS=1.0
